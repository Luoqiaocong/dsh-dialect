{
  "name": "dsh-dialect",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 插件：让模型回答里偶尔自然夹带方言。插件页里直接选东北话、天津话、北京话或粤语，调频率和强度，也可以从随机池里抽。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dialect",
    "方言",
    "东北话",
    "粤语"
  ],
  "license": "MIT",
  "author": "Luoqiaocong",
  "homepage": "https://github.com/Luoqiaocong/dsh-dialect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luoqiaocong/dsh-dialect.git"
  },
  "bugs": {
    "url": "https://github.com/Luoqiaocong/dsh-dialect/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node scripts/smoke.mjs && node scripts/client-smoke.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}

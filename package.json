{
  "name": "dsh-dialect",
  "version": "0.3.0-beta.1",
  "type": "module",
  "description": "DSH 方言彩蛋：Settings 里完整配置，对话输入框旁按会话快捷切换；五档频率，高和极高有警示配色。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dialect",
    "dialect-spice",
    "方言",
    "东北话",
    "天津话",
    "北京话",
    "粤语"
  ],
  "license": "MIT",
  "author": "Luoqiaocong",
  "homepage": "https://github.com/Luoqiaocong/dsh-dialect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luoqiaocong/dsh-dialect.git"
  },
  "bugs": {
    "url": "https://github.com/Luoqiaocong/dsh-dialect/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node scripts/smoke.mjs && node scripts/client-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
